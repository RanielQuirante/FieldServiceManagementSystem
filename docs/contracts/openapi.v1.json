{
  "openapi": "3.1.1",
  "info": {
    "title": "FieldService API",
    "version": "v1"
  },
  "paths": {
    "/api/auth/sign-in": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign in",
        "description": "Exchanges an email address and password for an access token and a new session. The Web client accepts only administrators and receives the refresh token in the fs_refresh cookie; the Mobile client accepts only technicians and receives it in the body.",
        "operationId": "SignIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Refresh a session",
        "description": "Rotates the refresh token and issues a new access token. The Web client sends no body, the fs_refresh cookie and the X-FieldService-Csrf header; the Mobile client sends its refresh token in the body.",
        "operationId": "RefreshSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/RefreshSessionRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-out": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign out",
        "description": "Revokes the session that the refresh credential belongs to. The Web client sends the fs_refresh cookie and the X-FieldService-Csrf header, and the response clears the cookie; the Mobile client sends its refresh token in the body. A missing, unknown, expired or revoked credential also returns 204.",
        "operationId": "SignOut",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/SignOutRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs": {
      "post": {
        "tags": [
          "Jobs"
        ],
        "summary": "Create a job",
        "description": "Creates an unassigned job with the next job number and a Created history entry. The response carries the job's details and version, and its Location header points to the job.",
        "operationId": "CreateJob",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateJobRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDetailsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      },
      "get": {
        "tags": [
          "Jobs"
        ],
        "summary": "List jobs",
        "description": "Returns one page of jobs that match every filter, ordered by last update with the newest first, with the total count and the count for each status under every filter except status. The search matches the job number, title, customer and site address.",
        "operationId": "GetJobs",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/JobStatus"
            }
          },
          {
            "name": "technicianId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "priority",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/JobPriority"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 25
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetJobsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/api/jobs/{jobId}": {
      "get": {
        "tags": [
          "Jobs"
        ],
        "summary": "Get a job",
        "description": "Returns the job with its assignee, its complete history, oldest first, and the version to send with the next command. A technician can read only the jobs assigned to them; any other job returns 404.",
        "operationId": "GetJobById",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDetailsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/api/checklist-templates": {
      "get": {
        "tags": [
          "ChecklistTemplates"
        ],
        "summary": "List checklist templates",
        "description": "Returns every checklist template, ordered by name, with its trade and item count. The create-job form offers them as the job's checklist.",
        "operationId": "GetChecklistTemplates",
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetChecklistTemplatesResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ChecklistTemplateReference": {
        "required": [
          "id",
          "name",
          "trade"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "trade": {
            "$ref": "#/components/schemas/Trade"
          }
        }
      },
      "ChecklistTemplateResponse": {
        "required": [
          "id",
          "name",
          "trade",
          "itemCount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "trade": {
            "$ref": "#/components/schemas/Trade"
          },
          "itemCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CreateJobRequest": {
        "required": [
          "title",
          "description",
          "priority",
          "customerName",
          "siteAddress",
          "scheduledStart",
          "scheduledEnd",
          "checklistTemplateId"
        ],
        "type": "object",
        "properties": {
          "title": {
            "maxLength": 120,
            "minLength": 0,
            "type": "string"
          },
          "description": {
            "maxLength": 2000,
            "minLength": 0,
            "type": "string"
          },
          "priority": {
            "$ref": "#/components/schemas/JobPriority"
          },
          "customerName": {
            "maxLength": 120,
            "minLength": 0,
            "type": "string"
          },
          "siteAddress": {
            "maxLength": 300,
            "minLength": 0,
            "type": "string"
          },
          "siteAccessNotes": {
            "maxLength": 500,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "contactName": {
            "maxLength": 100,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "contactPhone": {
            "maxLength": 32,
            "minLength": 0,
            "pattern": "^\\+?[0-9 ().-]{3,31}$",
            "type": [
              "null",
              "string"
            ]
          },
          "equipment": {
            "maxLength": 200,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "scheduledStart": {
            "type": "string",
            "format": "date-time"
          },
          "scheduledEnd": {
            "type": "string",
            "format": "date-time"
          },
          "checklistTemplateId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "GetChecklistTemplatesResponse": {
        "required": [
          "items"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChecklistTemplateResponse"
            }
          }
        }
      },
      "GetJobsResponse": {
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount",
          "statusCounts"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobSummaryResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalCount": {
            "type": "integer",
            "format": "int32"
          },
          "statusCounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobStatusCount"
            }
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "code": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          }
        }
      },
      "JobDetailsResponse": {
        "required": [
          "id",
          "number",
          "title",
          "description",
          "priority",
          "status",
          "customerName",
          "siteAddress",
          "siteAccessNotes",
          "contactName",
          "contactPhone",
          "equipment",
          "scheduledStart",
          "scheduledEnd",
          "checklistTemplate",
          "assignedTechnician",
          "createdBy",
          "createdAt",
          "updatedAt",
          "assignedAt",
          "startedAt",
          "completedAt",
          "cancelledAt",
          "history",
          "version"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "number": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "priority": {
            "$ref": "#/components/schemas/JobPriority"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "customerName": {
            "type": "string"
          },
          "siteAddress": {
            "type": "string"
          },
          "siteAccessNotes": {
            "type": [
              "null",
              "string"
            ]
          },
          "contactName": {
            "type": [
              "null",
              "string"
            ]
          },
          "contactPhone": {
            "type": [
              "null",
              "string"
            ]
          },
          "equipment": {
            "type": [
              "null",
              "string"
            ]
          },
          "scheduledStart": {
            "type": "string",
            "format": "date-time"
          },
          "scheduledEnd": {
            "type": "string",
            "format": "date-time"
          },
          "checklistTemplate": {
            "$ref": "#/components/schemas/ChecklistTemplateReference"
          },
          "assignedTechnician": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JobTechnicianReference"
              }
            ]
          },
          "createdBy": {
            "$ref": "#/components/schemas/UserReference"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "assignedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "startedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "completedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "cancelledAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobHistoryEntryResponse"
            }
          },
          "version": {
            "type": "integer",
            "format": "uint32"
          }
        }
      },
      "JobHistoryAction": {
        "enum": [
          "Created",
          "Assigned",
          "Started",
          "PutOnHold",
          "Resumed",
          "Completed",
          "Cancelled"
        ]
      },
      "JobHistoryEntryResponse": {
        "required": [
          "id",
          "action",
          "fromStatus",
          "toStatus",
          "actor",
          "technician",
          "note",
          "occurredAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "action": {
            "$ref": "#/components/schemas/JobHistoryAction"
          },
          "fromStatus": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JobStatus"
              }
            ]
          },
          "toStatus": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "actor": {
            "$ref": "#/components/schemas/UserReference"
          },
          "technician": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/UserReference"
              }
            ]
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "JobPriority": {
        "enum": [
          "Low",
          "Normal",
          "High",
          "Urgent"
        ]
      },
      "JobStatus": {
        "enum": [
          "Unassigned",
          "Assigned",
          "InProgress",
          "OnHold",
          "Completed",
          "Cancelled"
        ]
      },
      "JobStatusCount": {
        "required": [
          "status",
          "count"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "count": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "JobSummaryResponse": {
        "required": [
          "id",
          "number",
          "title",
          "priority",
          "status",
          "customerName",
          "siteAddress",
          "scheduledStart",
          "scheduledEnd",
          "assignedTechnician",
          "updatedAt",
          "version"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "number": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "priority": {
            "$ref": "#/components/schemas/JobPriority"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "customerName": {
            "type": "string"
          },
          "siteAddress": {
            "type": "string"
          },
          "scheduledStart": {
            "type": "string",
            "format": "date-time"
          },
          "scheduledEnd": {
            "type": "string",
            "format": "date-time"
          },
          "assignedTechnician": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JobTechnicianReference"
              }
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
