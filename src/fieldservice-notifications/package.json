{
  "name": "fieldservice-notifications",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.12.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "format:check": "prettier --check . ../../tests/notification-tests --ignore-path ../../.gitignore",
    "test": "npm --prefix ../../tests/notification-tests test"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "pino": "^10.4.0",
    "pino-roll": "^4.0.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node26": "^26.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "pino-pretty": "^13.2.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
