{
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "Logs": {
    "Directory": "logs",
    "FileEnabled": true,
    "RetainedFileCountLimit": 14,
    "FileSizeLimitBytes": 52428800,
    "ConsoleFormat": "Json"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Notifications": {
    "BaseUrl": ""
  },
  "Seed": {
    "DemoData": false
  }
}
