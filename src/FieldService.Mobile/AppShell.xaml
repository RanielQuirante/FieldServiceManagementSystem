<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:jobs="clr-namespace:FieldService.Mobile.Features.Jobs"
       xmlns:signIn="clr-namespace:FieldService.Mobile.Features.SignIn"
       x:Class="FieldService.Mobile.AppShell"
       Title="FieldService Tech"
       FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       Shell.TabBarIsVisible="False">
    <ShellContent Title="Sign in"
                  Route="sign-in"
                  ContentTemplate="{DataTemplate signIn:SignInPage}" />
    <ShellContent Title="My jobs"
                  Route="jobs"
                  ContentTemplate="{DataTemplate jobs:MyJobsPage}" />
</Shell>
