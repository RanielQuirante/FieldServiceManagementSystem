<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <LinearGradientBrush x:Key="FsBackdropBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F4F7FB" Offset="0" />
        <GradientStop Color="#F3F6F4" Offset="0.5" />
        <GradientStop Color="#EEF5F4" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="FsPrimaryBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource FsNavy900}" Offset="0" />
        <GradientStop Color="{StaticResource FsTeal700}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="FsPrimaryPressedBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource FsNavy950}" Offset="0" />
        <GradientStop Color="{StaticResource FsTeal800}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="FsGlossBrush" StartPoint="0,0" EndPoint="0.6,0.6">
        <GradientStop Color="#2EFFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="FsAccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource FsAmber500}" Offset="0" />
        <GradientStop Color="{StaticResource FsOrange500}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="FsHeroBrush" StartPoint="0,0" EndPoint="0.8,1">
