<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FieldService.Mobile.Shared.Controls"
             x:Class="FieldService.Mobile.Shared.Controls.PrimaryButton"
             x:Name="Root"
             x:DataType="controls:PrimaryButton">
    <Grid BindingContext="{x:Reference Root}"
          MinimumHeightRequest="{StaticResource FsHeightPrimary}">
        <Button x:Name="CoreButton"
                Text="{Binding ButtonText}"
                Command="{Binding Command}"
                CommandParameter="{Binding CommandParameter}"
                SemanticProperties.Description="{Binding DisplayText}"
                Background="{StaticResource FsPrimaryBrush}"
                TextColor="{StaticResource FsOnDark}"
                FontFamily="GeistSemiBold"
                FontSize="{StaticResource FsFontSizeButton}"
                CharacterSpacing="{StaticResource FsTrackingButton}"
                CornerRadius="16"
                BorderWidth="0"
                Padding="{StaticResource FsPaddingPrimaryButton}"
                MinimumHeightRequest="{StaticResource FsHeightPrimary}"
                Shadow="{StaticResource FsShadowPrimary}">
            <Button.Triggers>
                <DataTrigger TargetType="Button" Binding="{Binding ShowsDisabledLook}" Value="True">
                    <Setter Property="Background" Value="{StaticResource FsDisabledFillBrush}" />
                    <Setter Property="TextColor" Value="{StaticResource FsDisabledText}" />
                    <Setter Property="Shadow" Value="{x:Null}" />
                </DataTrigger>
            </Button.Triggers>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver" />
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Background" Value="{StaticResource FsPrimaryPressedBrush}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Unfocused" />
                        <VisualState x:Name="Focused">
                            <VisualState.Setters>
                                <Setter Property="BorderColor" Value="{StaticResource FsFocus}" />
                                <Setter Property="BorderWidth" Value="2" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
        </Button>
        <BoxView CornerRadius="16"
                 Background="{StaticResource FsGlossBrush}"
                 InputTransparent="True"
                 AutomationProperties.IsInAccessibleTree="False">
            <BoxView.Triggers>
                <DataTrigger TargetType="BoxView" Binding="{Binding ShowsDisabledLook}" Value="True">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </BoxView.Triggers>
        </BoxView>
        <HorizontalStackLayout IsVisible="{Binding HasIcon}"
                               Spacing="{StaticResource FsSpace10}"
                               HorizontalOptions="Center"
                               InputTransparent="True"
                               AutomationProperties.ExcludedWithChildren="True">
            <controls:Icon PathData="{Binding IconData}"
                           Size="20"
                           Color="{StaticResource FsOnDark}"
                           VerticalOptions="Center">
                <controls:Icon.Triggers>
                    <DataTrigger TargetType="controls:Icon" Binding="{Binding ShowsDisabledLook}" Value="True">
                        <Setter Property="Color" Value="{StaticResource FsDisabledText}" />
                    </DataTrigger>
                </controls:Icon.Triggers>
            </controls:Icon>
            <Label Text="{Binding DisplayText}"
                   Style="{StaticResource FsTextButtonLabel}"
                   TextColor="{StaticResource FsOnDark}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding ShowsDisabledLook}" Value="True">
                        <Setter Property="TextColor" Value="{StaticResource FsDisabledText}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </HorizontalStackLayout>
    </Grid>
</ContentView>
