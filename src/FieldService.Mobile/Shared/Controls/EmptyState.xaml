<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FieldService.Mobile.Shared.Controls"
             x:Class="FieldService.Mobile.Shared.Controls.EmptyState"
             x:Name="Root"
             x:DataType="controls:EmptyState">
    <Border BindingContext="{x:Reference Root}"
            Style="{StaticResource FsGlassCard}"
            Padding="{StaticResource FsPaddingEmptyState}">
        <VerticalStackLayout Spacing="{StaticResource FsSpace16}">
            <controls:IconTile IconData="{Binding IconData}"
                               TileSize="56" />
            <VerticalStackLayout Spacing="{StaticResource FsSpace6}">
                <Label Text="{Binding Title}"
                       Style="{StaticResource FsTextLargeHeading}"
                       SemanticProperties.HeadingLevel="Level2"
                       controls:ListSemantics.IsOwnStop="True" />
                <Label Text="{Binding Message}"
                       Style="{StaticResource FsTextBodySecondary}"
                       controls:ListSemantics.IsOwnStop="True" />
            </VerticalStackLayout>
            <Grid IsVisible="{Binding HasAction}"
                  HorizontalOptions="Start">
                <Button Style="{StaticResource FsSecondaryButton}"
                        Padding="{StaticResource FsPaddingSecondaryButton}"
                        Command="{Binding ActionCommand}"
                        SemanticProperties.Description="{Binding ActionDescription}" />
                <HorizontalStackLayout Spacing="{StaticResource FsSpace10}"
                                       Padding="{StaticResource FsPaddingSecondaryButton}"
                                       HorizontalOptions="Center"
                                       InputTransparent="True"
                                       AutomationProperties.ExcludedWithChildren="True">
                    <controls:Icon PathData="{StaticResource FsIconRefresh}"
                                   Size="20"
                                   Color="{StaticResource FsTeal700}"
                                   VerticalOptions="Center" />
                    <Label Text="{Binding ActionText}"
                           Style="{StaticResource FsTextButtonLabel}" />
                </HorizontalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
