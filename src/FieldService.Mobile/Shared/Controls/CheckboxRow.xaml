<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FieldService.Mobile.Shared.Controls"
             x:Class="FieldService.Mobile.Shared.Controls.CheckboxRow"
             x:Name="Root"
             x:DataType="controls:CheckboxRow">
    <ContentView.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnTapped" />
    </ContentView.GestureRecognizers>
    <VerticalStackLayout BindingContext="{x:Reference Root}"
                         Spacing="{StaticResource FsSpace8}"
                         InputTransparent="True"
                         AutomationProperties.ExcludedWithChildren="True">
        <Border x:Name="Surface"
                Style="{StaticResource FsGlassCard}"
                Padding="{StaticResource FsPaddingItemCard}"
                MinimumHeightRequest="{StaticResource FsHeightCheckboxRow}"
                AutomationProperties.IsInAccessibleTree="False">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="{StaticResource FsSpace14}">
                <CheckBox x:Name="Box"
                          IsChecked="{Binding IsChecked}"
                          Color="{StaticResource FsTeal700}"
                          WidthRequest="22"
                          HeightRequest="22"
                          MinimumWidthRequest="22"
                          MinimumHeightRequest="22"
                          Margin="0,1,0,0"
                          VerticalOptions="Start"
                          InputTransparent="True"
                          controls:TabStop.IsStop="False"
                          AutomationProperties.IsInAccessibleTree="False" />
                <Label Grid.Column="1"
                       Text="{Binding Text}"
                       Style="{StaticResource FsTextCheckboxLabel}"
                       AutomationProperties.IsInAccessibleTree="False" />
            </Grid>
        </Border>
        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="{StaticResource FsSpace6}"
              IsVisible="{Binding HasError}">
            <Grid Grid.Column="0"
                  WidthRequest="16"
                  VerticalOptions="Start">
                <Label Style="{StaticResource FsTextFieldError}"
                       Text="A"
                       MaxLines="1"
                       LineBreakMode="NoWrap"
                       Opacity="0"
                       InputTransparent="True"
                       AutomationProperties.IsInAccessibleTree="False" />
                <controls:Icon PathData="{StaticResource FsIconAlertTriangle}"
                               Size="16"
                               Color="{StaticResource FsDanger}"
                               VerticalOptions="Center" />
            </Grid>
            <Label Grid.Column="1"
                   Text="{Binding ErrorText}"
                   Style="{StaticResource FsTextFieldError}"
                   AutomationProperties.IsInAccessibleTree="False" />
        </Grid>
    </VerticalStackLayout>
</ContentView>
