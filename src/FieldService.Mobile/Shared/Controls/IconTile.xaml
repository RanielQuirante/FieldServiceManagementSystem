<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FieldService.Mobile.Shared.Controls"
             x:Class="FieldService.Mobile.Shared.Controls.IconTile"
             x:Name="Root"
             x:DataType="controls:IconTile"
             InputTransparent="True"
             AutomationProperties.IsInAccessibleTree="False"
             AutomationProperties.ExcludedWithChildren="True">
    <Border x:Name="Tile"
            BindingContext="{x:Reference Root}"
            Style="{StaticResource FsIconTile}"
            WidthRequest="{Binding TileSize}"
            HeightRequest="{Binding TileSize}"
            HorizontalOptions="Start"
            VerticalOptions="Start"
            InputTransparent="True"
            AutomationProperties.IsInAccessibleTree="False">
        <controls:Icon PathData="{Binding IconData}"
                       Size="{Binding IconSize}"
                       Color="{StaticResource FsTeal700}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
    </Border>
</ContentView>
