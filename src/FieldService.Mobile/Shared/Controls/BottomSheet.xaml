<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FieldService.Mobile.Shared.Controls"
             x:Class="FieldService.Mobile.Shared.Controls.BottomSheet"
             x:DataType="controls:BottomSheet"
             SafeAreaEdges="None">
    <ContentView.ControlTemplate>
        <ControlTemplate x:DataType="controls:BottomSheet">
            <Grid x:Name="SheetRoot"
                  IsVisible="{TemplateBinding IsOpen}"
                  SafeAreaEdges="None,None,None,SoftInput">
                <BoxView Color="{StaticResource FsOverlay}"
                         InputTransparent="False"
                         AutomationProperties.IsInAccessibleTree="False">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Command="{TemplateBinding CloseCommand}" />
                    </BoxView.GestureRecognizers>
                </BoxView>
                <Border x:Name="SheetSurface"
                        Style="{StaticResource FsSheet}"
                        Padding="{TemplateBinding SheetPadding}"
                        VerticalOptions="End">
                    <VerticalStackLayout>
                        <BoxView x:Name="SheetHandle"
                                 WidthRequest="{StaticResource FsWidthSheetHandle}"
                                 HeightRequest="{StaticResource FsHeightSheetHandle}"
                                 Margin="{StaticResource FsMarginSheetHandle}"
                                 CornerRadius="3"
                                 Color="{StaticResource FsSheetHandle}"
                                 HorizontalOptions="Center"
                                 InputTransparent="True"
                                 AutomationProperties.IsInAccessibleTree="False" />
                        <ContentView x:Name="SheetHeader"
                                     Content="{TemplateBinding Header}"
                                     IsVisible="{TemplateBinding HasHeader}"
                                     Padding="{StaticResource FsPaddingSheetHeader}" />
                        <BoxView x:Name="SheetHairline"
                                 HeightRequest="1"
                                 Color="{StaticResource FsHairlineSoft}"
                                 IsVisible="{TemplateBinding HasHeader}"
                                 Opacity="0"
                                 InputTransparent="True"
                                 AutomationProperties.IsInAccessibleTree="False" />
                        <ScrollView x:Name="SheetScroll"
                                    MaximumHeightRequest="{TemplateBinding ContentMaxHeight}">
                            <ContentPresenter Padding="{TemplateBinding ContentPadding}" />
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ControlTemplate>
    </ContentView.ControlTemplate>
</ContentView>
