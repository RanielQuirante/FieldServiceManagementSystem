<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FieldService.Mobile.Shared.Controls"
             x:Class="FieldService.Mobile.Shared.Controls.CountCapsule"
             x:Name="Root"
             x:DataType="controls:CountCapsule"
             InputTransparent="True"
             AutomationProperties.IsInAccessibleTree="False"
             AutomationProperties.ExcludedWithChildren="True">
    <Border x:Name="Capsule"
            BindingContext="{x:Reference Root}"
            Style="{StaticResource FsCapsule}"
            VerticalOptions="Center"
            InputTransparent="True"
            AutomationProperties.IsInAccessibleTree="False">
        <Label x:Name="CountLabel"
               Text="{Binding Text}"
               Style="{StaticResource FsTextCount}"
               HorizontalOptions="Center"
               VerticalOptions="Center" />
    </Border>
</ContentView>
