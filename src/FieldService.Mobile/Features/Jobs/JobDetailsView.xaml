<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FieldService.Mobile.Shared.Controls"
             xmlns:jobs="clr-namespace:FieldService.Mobile.Features.Jobs"
             x:Class="FieldService.Mobile.Features.Jobs.JobDetailsView"
             x:DataType="jobs:JobDetailsViewModel"
             SafeAreaEdges="None">
    <Grid RowDefinitions="*,Auto"
          SafeAreaEdges="None">
        <ScrollView x:Name="DetailsScroll"
                    Grid.Row="0"
                    SafeAreaEdges="None"
                    controls:ScrollRequests.ToTop="{Binding ScrollToTopRequest}"
                    AutomationProperties.ExcludedWithChildren="{Binding IsStatusSheetOpen}">
            <VerticalStackLayout SafeAreaEdges="None">
                <controls:AppHeader x:Name="DetailsHeader"
                                    Variant="Pushed"
                                    IsVisible="{Binding ShowsPushedHeader}"
                                    Title="{x:Static jobs:JobDetailsViewModel.PageTitle}"
                                    Subtitle="{Binding JobNumber}"
                                    BackCommand="{Binding BackCommand}"
                                    BackDescription="Back to my jobs"
                                    HasSummary="{Binding HasJob}"
                                    SummaryStatus="{Binding Status}"
                                    SummaryPriority="{Binding Priority}"
                                    SummaryTitle="{Binding Title}"
                                    HasSchedule="{Binding IsAssigned}"
                                    ScheduleText="{Binding ScheduleLine}"
                                    StartsText="{Binding StartsLine}"
                                    AssignedText="{Binding AssignedLine}"
                                    StatusLineText="{Binding StatusLine}"
                                    ReasonText="{Binding ReasonLine}"
                                    StatusDescription="{Binding StatusDescription}"
                                    SummaryFocusRequest="{Binding TitleFocusRequest}" />
                <VerticalStackLayout Padding="{Binding ContentPadding}"
                                     Spacing="{StaticResource FsSpace16}">
                    <Border Style="{StaticResource FsPaneHero}"
                            IsVisible="{Binding ShowsPaneHero}">
                        <VerticalStackLayout Spacing="{StaticResource FsSpace12}">
                            <HorizontalStackLayout Spacing="{StaticResource FsSpace8}">
                                <controls:StatusChip Status="{Binding Status}" />
                                <controls:PriorityLabel Priority="{Binding Priority}"
                                                        IsOnDark="True" />
                                <Label Text="{Binding JobNumber}"
                                       Style="{StaticResource FsTextMonoOnDark}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Title}"
                                   Style="{StaticResource FsTextPaneHeroTitle}"
                                   SemanticProperties.HeadingLevel="Level2" />
                            <VerticalStackLayout IsVisible="{Binding IsAssigned}"
                                                 Spacing="{StaticResource FsSpace4}">
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="{StaticResource FsSpace8}">
                                    <Grid WidthRequest="16"
                                          VerticalOptions="Start">
                                        <Label Style="{StaticResource FsTextScheduleOnDark}"
                                               Text="A"
                                               MaxLines="1"
                                               LineBreakMode="NoWrap"
                                               Opacity="0"
                                               InputTransparent="True"
                                               AutomationProperties.IsInAccessibleTree="False" />
                                        <controls:Icon PathData="{StaticResource FsIconClock}"
                                                       Size="16"
                                                       Color="{StaticResource FsOnDark}"
                                                       VerticalOptions="Center" />
                                    </Grid>
                                    <Label Grid.Column="1"
                                           Text="{Binding ScheduleLine}"
                                           Style="{StaticResource FsTextScheduleOnDark}" />
                                </Grid>
                                <Label Text="{Binding StartsLine}"
                                       IsVisible="{Binding HasStartsLine}"
                                       Style="{StaticResource FsTextMetaOnDark}" />
                                <Label Text="{Binding AssignedLine}"
                                       IsVisible="{Binding HasAssignedLine}"
                                       Style="{StaticResource FsTextMetaOnDark}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout IsVisible="{Binding ShowsPaneMeta}"
                                                 Spacing="{StaticResource FsSpace4}"
                                                 SemanticProperties.Description="{Binding PaneStatusDescription}">
                                <Label Text="{Binding PaneMeta}"
                                       Style="{StaticResource FsTextMetaOnDark}"
                                       AutomationProperties.ExcludedWithChildren="{Binding HasStatusDescription}" />
                                <Label Text="{Binding ReasonLine}"
                                       IsVisible="{Binding HasReasonLine}"
                                       Style="{StaticResource FsTextMetaOnDark}"
                                       MaxLines="3"
                                       LineBreakMode="TailTruncation"
                                       AutomationProperties.ExcludedWithChildren="{Binding HasStatusDescription}" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout IsVisible="{Binding ShowsHeroActions}"
                                                   Spacing="{StaticResource FsSpace10}">
                                <Grid IsVisible="{Binding ShowsStartJob}">
                                    <Button Style="{StaticResource FsPrimaryOnDarkDesktopButton}"
                                            Command="{Binding StartJobCommand}"
                                            SemanticProperties.Description="{Binding StartJobLabel}" />
                                    <HorizontalStackLayout Spacing="{StaticResource FsSpace8}"
                                                           Padding="{StaticResource FsPaddingDesktopButton}"
                                                           HorizontalOptions="Center"
                                                           InputTransparent="True"
                                                           AutomationProperties.ExcludedWithChildren="True">
                                        <controls:Icon PathData="{StaticResource FsIconPlayCircle}"
                                                       Size="18"
                                                       Color="{StaticResource FsInk}"
                                                       VerticalOptions="Center" />
                                        <Label Text="{Binding StartJobLabel}"
                                               Style="{StaticResource FsTextButtonLabelDesktop}"
                                               TextColor="{StaticResource FsInk}" />
                                    </HorizontalStackLayout>
                                </Grid>
                                <Grid IsVisible="{Binding ShowsInspectionAction}">
                                    <Button Style="{StaticResource FsPrimaryOnDarkDesktopButton}"
                                            Command="{Binding OpenChecklistCommand}"
                                            SemanticProperties.Description="{Binding InspectionActionText}" />
                                    <HorizontalStackLayout Spacing="{StaticResource FsSpace8}"
                                                           Padding="{StaticResource FsPaddingDesktopButton}"
                                                           HorizontalOptions="Center"
                                                           InputTransparent="True"
                                                           AutomationProperties.ExcludedWithChildren="True">
                                        <controls:Icon PathData="{StaticResource FsIconClipboardCheck}"
                                                       Size="18"
                                                       Color="{StaticResource FsInk}"
                                                       VerticalOptions="Center" />
                                        <Label Text="{Binding InspectionActionText}"
                                               Style="{StaticResource FsTextButtonLabelDesktop}"
                                               TextColor="{StaticResource FsInk}" />
                                    </HorizontalStackLayout>
                                </Grid>
                                <Grid IsVisible="{Binding ShowsUpdateStatusSecondary}">
                                    <Button Style="{StaticResource FsSecondaryOnDarkDesktopButton}"
                                            Command="{Binding OpenStatusSheetCommand}"
                                            SemanticProperties.Description="{x:Static jobs:JobDetailsViewModel.UpdateStatusText}" />
                                    <HorizontalStackLayout Spacing="{StaticResource FsSpace8}"
                                                           Padding="{StaticResource FsPaddingDesktopButton}"
                                                           HorizontalOptions="Center"
                                                           InputTransparent="True"
                                                           AutomationProperties.ExcludedWithChildren="True">
                                        <controls:Icon PathData="{StaticResource FsIconActivity}"
                                                       Size="18"
                                                       Color="{StaticResource FsOnDark}"
                                                       VerticalOptions="Center" />
                                        <Label Text="{x:Static jobs:JobDetailsViewModel.UpdateStatusText}"
                                               Style="{StaticResource FsTextButtonLabelDesktop}"
                                               TextColor="{StaticResource FsOnDark}" />
                                    </HorizontalStackLayout>
                                </Grid>
                                <Grid IsVisible="{Binding ShowsUpdateStatusPrimary}">
                                    <Button Style="{StaticResource FsPrimaryOnDarkDesktopButton}"
                                            Command="{Binding OpenStatusSheetCommand}"
                                            SemanticProperties.Description="{x:Static jobs:JobDetailsViewModel.UpdateStatusText}" />
                                    <HorizontalStackLayout Spacing="{StaticResource FsSpace8}"
                                                           Padding="{StaticResource FsPaddingDesktopButton}"
                                                           HorizontalOptions="Center"
                                                           InputTransparent="True"
                                                           AutomationProperties.ExcludedWithChildren="True">
                                        <controls:Icon PathData="{StaticResource FsIconActivity}"
                                                       Size="18"
                                                       Color="{StaticResource FsInk}"
                                                       VerticalOptions="Center" />
                                        <Label Text="{x:Static jobs:JobDetailsViewModel.UpdateStatusText}"
                                               Style="{StaticResource FsTextButtonLabelDesktop}"
                                               TextColor="{StaticResource FsInk}" />
                                    </HorizontalStackLayout>
                                </Grid>
                                <Grid IsVisible="{Binding ShowsNavigationRow}">
                                    <Button Style="{StaticResource FsSecondaryOnDarkDesktopButton}"
                                            Command="{Binding NavigateCommand}"
                                            SemanticProperties.Description="{Binding NavigateLabel}" />
                                    <HorizontalStackLayout Spacing="{StaticResource FsSpace8}"
                                                           Padding="{StaticResource FsPaddingDesktopButton}"
                                                           HorizontalOptions="Center"
                                                           InputTransparent="True"
                                                           AutomationProperties.ExcludedWithChildren="True">
                                        <controls:Icon PathData="{StaticResource FsIconNavigation}"
                                                       Size="18"
                                                       Color="{StaticResource FsOnDark}"
                                                       VerticalOptions="Center" />
                                        <Label Text="Navigate"
                                               Style="{StaticResource FsTextButtonLabelDesktop}"
                                               TextColor="{StaticResource FsOnDark}" />
                                    </HorizontalStackLayout>
                                </Grid>
                                <Grid IsVisible="{Binding ShowsCallAction}">
                                    <Button Style="{StaticResource FsSecondaryOnDarkDesktopButton}"
                                            Command="{Binding CallCommand}"
                                            SemanticProperties.Description="{Binding CallLabel}" />
                                    <HorizontalStackLayout Spacing="{StaticResource FsSpace8}"
                                                           Padding="{StaticResource FsPaddingDesktopButton}"
                                                           HorizontalOptions="Center"
                                                           InputTransparent="True"
                                                           AutomationProperties.ExcludedWithChildren="True">
                                        <controls:Icon PathData="{StaticResource FsIconPhone}"
                                                       Size="18"
                                                       Color="{StaticResource FsOnDark}"
                                                       VerticalOptions="Center" />
                                        <Label Text="Call"
                                               Style="{StaticResource FsTextButtonLabelDesktop}"
                                               TextColor="{StaticResource FsOnDark}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <controls:Banner Variant="{Binding ActionBanner.Variant}"
                                     IsVisible="{Binding HasActionBanner}"
                                     Title="{Binding ActionBanner.Title}"
                                     Message="{Binding ActionBanner.Message}"
                                     Reference="{Binding ActionBanner.Reference}" />
                    <controls:Banner Variant="Offline"
                                     IsVisible="{Binding IsOffline}"
                                     Title="{x:Static jobs:JobDetailsViewModel.OfflineTitle}"
                                     Message="{Binding OfflineMessage}"
                                     ActionText="Try again"
                                     ActionCommand="{Binding RetryCommand}" />
                    <controls:Banner Variant="Error"
                                     IsVisible="{Binding HasRefreshError}"
                                     Title="{Binding RefreshError.Title}"
                                     Message="{Binding RefreshError.Message}"
                                     Reference="{Binding RefreshError.Reference}"
                                     ActionText="Try again"
                                     ActionCommand="{Binding RetryCommand}" />
                    <controls:Banner Variant="Error"
                                     IsVisible="{Binding IsError}"
                                     Title="{Binding Error.Title}"
                                     Message="{Binding Error.Message}"
                                     Reference="{Binding Error.Reference}"
                                     ActionText="Try again"
                                     ActionCommand="{Binding RetryCommand}" />
                    <controls:JobCard IsLoading="True"
                                      IsVisible="{Binding IsLoading}" />
                    <Grid IsVisible="{Binding ShowsContent}"
                          ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="{StaticResource FsSpace20}"
                          RowSpacing="{StaticResource FsSpace16}">
                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="{Binding InfoColumnSpan}"
                                Style="{StaticResource FsInfoListCard}"
                                VerticalOptions="Start">
                            <VerticalStackLayout>
                                <controls:InfoRow IconData="{StaticResource FsIconBuilding}"
                                                  Label="Customer"
                                                  Value="{Binding CustomerName}"
                                                  ShowsDivider="False" />
                                <controls:InfoRow IconData="{StaticResource FsIconMapPin}"
                                                  Label="Site"
                                                  Value="{Binding SiteAddress}"
                                                  ShowsAction="{Binding ShowsRowActions}"
                                                  ActionIconData="{StaticResource FsIconNavigation}"
                                                  ActionDescription="{Binding NavigateLabel}"
                                                  ActionCommand="{Binding NavigateCommand}" />
                                <controls:InfoRow IconData="{StaticResource FsIconLock}"
                                                  Label="Access"
                                                  Value="{Binding AccessNotes}"
                                                  IsVisible="{Binding HasAccessNotes}" />
                                <controls:InfoRow IconData="{StaticResource FsIconUser}"
                                                  Label="Contact"
                                                  Value="{Binding ContactValue}"
                                                  SecondaryValue="{Binding ContactSecondary}"
                                                  IsVisible="{Binding HasContact}"
                                                  ShowsAction="{Binding ShowsRowCall}"
                                                  ActionIconData="{StaticResource FsIconPhone}"
                                                  ActionDescription="{Binding CallLabel}"
                                                  ActionCommand="{Binding CallCommand}" />
                                <controls:InfoRow IconData="{StaticResource FsIconCalendar}"
                                                  Label="Scheduled"
                                                  Value="{Binding ScheduledText}"
                                                  IsVisible="{Binding ShowsScheduledRow}" />
                                <controls:InfoRow IconData="{StaticResource FsIconWrench}"
                                                  Label="Equipment"
                                                  Value="{Binding Equipment}"
                                                  IsVisible="{Binding HasEquipment}" />
                                <controls:InfoRow IconData="{StaticResource FsIconClipboardCheck}"
                                                  Label="Checklist"
                                                  Value="{Binding ChecklistName}"
                                                  IsVisible="{Binding ShowsChecklistRow}" />
                            </VerticalStackLayout>
                        </Border>
                        <VerticalStackLayout Grid.Row="{Binding DetailsRow}"
                                             Grid.Column="{Binding DetailsColumn}"
                                             Grid.ColumnSpan="{Binding DetailsColumnSpan}"
                                             Spacing="{StaticResource FsSpace16}">
                            <Border Style="{StaticResource FsGlassCard}">
                                <VerticalStackLayout Spacing="{StaticResource FsSpace12}">
                                    <Label Text="Description"
                                           Style="{StaticResource FsTextSection}"
                                           SemanticProperties.HeadingLevel="Level2" />
                                    <Label Text="{Binding Description}"
                                           Style="{StaticResource FsTextBodySecondary}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Style="{StaticResource FsGlassCard}">
                                <VerticalStackLayout Spacing="{StaticResource FsSpace12}">
                                    <Label Text="Timeline"
                                           Style="{StaticResource FsTextSection}"
                                           SemanticProperties.HeadingLevel="Level2" />
                                    <controls:Timeline Entries="{Binding Timeline}" />
                                </VerticalStackLayout>
                            </Border>
                            <controls:LinkCard IsVisible="{Binding ShowsChecklistLink}"
                                               IconData="{StaticResource FsIconClipboardCheck}"
                                               Title="{Binding ChecklistName}"
                                               Subtitle="{Binding ChecklistSubline}"
                                               LinkDescription="{Binding ChecklistLinkDescription}"
                                               Command="{Binding OpenChecklistCommand}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <controls:StatusBarProtection Grid.Row="0"
                                      IsActive="{Binding ShowsPushedHeader}"
                                      ScrollSource="{x:Reference DetailsScroll}" />
        <controls:SystemBarSpacer Grid.Row="1" />
        <controls:ActionDock Grid.Row="1"
                             IsVisible="{Binding ShowsDock}"
                             HelperText="{Binding DockHelper}"
                             AutomationProperties.ExcludedWithChildren="{Binding IsStatusSheetOpen}">
            <VerticalStackLayout Spacing="{StaticResource FsSpace10}">
                <controls:DockButtonRow IsVisible="{Binding ShowsNavigationRow}">
                    <Grid>
                        <Button Style="{StaticResource FsSecondaryButton}"
                                Command="{Binding NavigateCommand}"
                                SemanticProperties.Description="{Binding NavigateLabel}" />
                        <HorizontalStackLayout Spacing="{StaticResource FsSpace10}"
                                               HorizontalOptions="Center"
                                               InputTransparent="True"
                                               AutomationProperties.ExcludedWithChildren="True">
                            <controls:Icon PathData="{StaticResource FsIconNavigation}"
                                           Size="20"
                                           Color="{StaticResource FsTeal700}"
                                           VerticalOptions="Center" />
                            <Label Text="Navigate"
                                   Style="{StaticResource FsTextButtonLabel}" />
                        </HorizontalStackLayout>
                    </Grid>
                    <Grid IsVisible="{Binding CanCall}">
                        <Button Style="{StaticResource FsSecondaryButton}"
                                Command="{Binding CallCommand}"
                                SemanticProperties.Description="{Binding CallLabel}" />
                        <HorizontalStackLayout Spacing="{StaticResource FsSpace10}"
                                               HorizontalOptions="Center"
                                               InputTransparent="True"
                                               AutomationProperties.ExcludedWithChildren="True">
                            <controls:Icon PathData="{StaticResource FsIconPhone}"
                                           Size="20"
                                           Color="{StaticResource FsTeal700}"
                                           VerticalOptions="Center" />
                            <Label Text="Call"
                                   Style="{StaticResource FsTextButtonLabel}" />
                        </HorizontalStackLayout>
                    </Grid>
                </controls:DockButtonRow>
                <controls:PrimaryButton IsVisible="{Binding ShowsStartJob}"
                                        Text="Start job"
                                        BusyText="Starting…"
                                        IconData="{StaticResource FsIconPlayCircle}"
                                        IsBusy="{Binding IsStarting}"
                                        Command="{Binding StartJobCommand}"
                                        SemanticFocusRequest="{Binding StartJobFocusRequest}" />
                <Grid IsVisible="{Binding ShowsUpdateStatusSecondary}">
                    <Button Style="{StaticResource FsSecondaryButton}"
                            Command="{Binding OpenStatusSheetCommand}"
                            SemanticProperties.Description="{x:Static jobs:JobDetailsViewModel.UpdateStatusText}"
                            controls:ScrollRequests.SemanticFocus="{Binding UpdateStatusFocusRequest}" />
                    <HorizontalStackLayout Spacing="{StaticResource FsSpace10}"
                                           HorizontalOptions="Center"
                                           InputTransparent="True"
                                           AutomationProperties.ExcludedWithChildren="True">
                        <controls:Icon PathData="{StaticResource FsIconActivity}"
                                       Size="20"
                                       Color="{StaticResource FsTeal700}"
                                       VerticalOptions="Center">
                            <controls:Icon.Triggers>
                                <DataTrigger TargetType="controls:Icon" Binding="{Binding CanUpdateStatus}" Value="False">
                                    <Setter Property="Color" Value="{StaticResource FsDisabledText}" />
                                </DataTrigger>
                            </controls:Icon.Triggers>
                        </controls:Icon>
                        <Label Text="{x:Static jobs:JobDetailsViewModel.UpdateStatusText}"
                               Style="{StaticResource FsTextButtonLabel}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding CanUpdateStatus}" Value="False">
                                    <Setter Property="TextColor" Value="{StaticResource FsDisabledText}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </HorizontalStackLayout>
                </Grid>
                <controls:PrimaryButton IsVisible="{Binding ShowsUpdateStatusPrimary}"
                                        Text="{x:Static jobs:JobDetailsViewModel.UpdateStatusText}"
                                        IconData="{StaticResource FsIconActivity}"
                                        Command="{Binding OpenStatusSheetCommand}"
                                        SemanticFocusRequest="{Binding UpdateStatusFocusRequest}" />
                <controls:PrimaryButton IsVisible="{Binding ShowsInspectionAction}"
                                        Text="{Binding InspectionActionText}"
                                        IconData="{StaticResource FsIconClipboardCheck}"
                                        Command="{Binding OpenChecklistCommand}" />
            </VerticalStackLayout>
        </controls:ActionDock>
        <controls:BottomSheet IsOpen="{Binding ShowsPhoneSheet}"
                              Title="{x:Static jobs:JobDetailsViewModel.SheetTitle}"
                              CloseCommand="{Binding CloseStatusSheetCommand}"
                              ScrollToEndRequest="{Binding SheetScrollRequest}"
                              Grid.RowSpan="2">
            <controls:BottomSheet.Header>
                <jobs:UpdateStatusSheetTitle />
            </controls:BottomSheet.Header>
            <jobs:UpdateStatusSheet />
        </controls:BottomSheet>
    </Grid>
</ContentView>
