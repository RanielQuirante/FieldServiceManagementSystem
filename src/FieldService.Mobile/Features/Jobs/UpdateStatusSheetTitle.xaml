<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:jobs="clr-namespace:FieldService.Mobile.Features.Jobs"
             xmlns:formatting="clr-namespace:FieldService.Mobile.Shared.Formatting"
             x:Class="FieldService.Mobile.Features.Jobs.UpdateStatusSheetTitle"
             x:DataType="jobs:JobDetailsViewModel">
    <VerticalStackLayout Spacing="{StaticResource FsSpace4}">
        <Label Text="{x:Static jobs:JobDetailsViewModel.SheetTitle}"
               Style="{StaticResource FsTextLargeHeading}"
               SemanticProperties.HeadingLevel="Level2" />
        <Label Style="{StaticResource FsTextMeta}"
               LineBreakMode="WordWrap">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="{Binding JobNumber}"
                          FontFamily="GeistMonoMedium"
                          FontSize="{StaticResource FsFontSizeMono}"
                          TextColor="{StaticResource FsMuted}" />
                    <Span Text="{x:Static formatting:DisplayFormats.Separator}" />
                    <Span Text="{Binding Title}" />
                </FormattedString>
            </Label.FormattedText>
        </Label>
    </VerticalStackLayout>
</ContentView>
